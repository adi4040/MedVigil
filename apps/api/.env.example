APP_NAME=MedV Microservice
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration
# Provider options: "gemini", "openai", or "mock"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=your_gemini_api_key_here

# Alternatively, provider-specific keys:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=medv_user
POSTGRES_PASSWORD=medv_password
POSTGRES_DB=medv_db
# Optional full connection string override:
# DATABASE_URL=postgresql+asyncpg://medv_user:medv_password@localhost:5432/medv_db
