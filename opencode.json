{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "agentrouter": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "AgentRouter",
      "settings": {
        "baseURL": "https://co.agentrouter.org/v1"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
