        "gpt-6-astra": {
          "name": "GPT-6 Astra"
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol"
        }
      }
    }
  },
  "model": "agentrouter/gpt-5.6-sol"
}
